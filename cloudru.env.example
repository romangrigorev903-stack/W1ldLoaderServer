NODE_ENV=production
PORT=8080
DB_PATH=/data/w1ld_auth.db
PUBLIC_URL=https://replace-with-container-app-url
CORS_ORIGIN=https://replace-with-container-app-url

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET=w1ld-auth-7ims-280726
S3_ACCESS_KEY_ID=replace-with-tenant-id-colon-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_CLIENTS_PREFIX=clients/
S3_DATABASE_PREFIX=database/
S3_FORCE_PATH_STYLE=true
REQUIRE_S3=true
LITESTREAM_ENABLED=true
